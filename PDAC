# ==============================
# PDAC Single-Cell Analysis Script
# Submission-ready for GitHub / Nature Biotechnology
# ==============================

# Install and load required packages
if (!requireNamespace("remotes", quietly = TRUE)) install.packages("remotes")
remotes::install_github("huayc09/SeuratExtend") # SeuratExtend

library(BiocManager)
library(Seurat)
library(SeuratDisk)
library(DESeq2)
library(tidyverse)
library(dplyr)
library(patchwork)
library(ggplot2)
library(clusterProfiler)
library(org.Hs.eg.db)
library(AnnotationHub)
library(SeuratExtend) # Extended Seurat functions (e.g., FeaturePlot3, FindSubCluster)

# Set seed for reproducibility
set.seed(123)

# ==============================
# 1. Load matrix and create Seurat object
# ==============================
mtx <- ReadMtx(
  mtx = "matrix.mtx.gz",
  features = "features.tsv.gz",
  cells = "barcodes.tsv.gz"
)

PDAC <- CreateSeuratObject(counts = mtx, project = "PDAC")
DefaultAssay(PDAC) <- "RNA"

# QC: mitochondrial content
PDAC[["percent.mt"]] <- PercentageFeatureSet(PDAC, pattern = "^MT-")
VlnPlot(PDAC, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)

# Filter cells
PDAC <- subset(PDAC, subset = nFeature_RNA > 200 & percent.mt < 15)

# Normalize and find variable features
PDAC <- NormalizeData(PDAC, normalization.method = "LogNormalize", scale.factor = 10000)
PDAC <- FindVariableFeatures(PDAC, selection.method = "vst", nfeatures = 2000)

# Visualize top variable features
top10_mer <- head(VariableFeatures(PDAC), 10)
VariableFeaturePlot(PDAC) %>% LabelPoints(points = top10_mer, repel = TRUE)

# ==============================
# 2. Scaling, PCA, and dimensional reduction
# ==============================
all.genes <- rownames(PDAC)
PDAC <- ScaleData(PDAC, features = all.genes)
PDAC <- RunPCA(PDAC, features = VariableFeatures(PDAC))
DimHeatmap(PDAC, dims = 1:17, cells = 500, balanced = TRUE)
ElbowPlot(PDAC)

PDAC <- RunUMAP(PDAC, dims = 1:17)
DimPlot(PDAC, group.by = "orig.ident")

PDAC <- FindNeighbors(PDAC, dims = 1:17)
PDAC <- FindClusters(PDAC, resolution = 0.2)
DimPlot(PDAC, reduction = "umap")

# ==============================
# 3. Rename clusters
# ==============================
new.cluster.ids <- c(
  "Cancer_1", "Cancer_2", "Cancer_3", "Cancer_4", "Mph", 
  "Fibroblast", "EMT", "Cancer_5", "EC"
)
names(new.cluster.ids) <- levels(PDAC)
PDAC <- RenameIdents(PDAC, new.cluster.ids)
DimPlot(PDAC, reduction = "umap", label = TRUE) + NoLegend()

# ==============================
# 4. Supervised subclustering (Macrophages)
# ==============================
subclustered_mph <- FindSubCluster(
  PDAC, cluster = "Mph", graph.name = "RNA_snn", subcluster.name = "subclusters"
)
mph_only <- subset(subclustered_mph, idents = "Mph")

markers <- c("CCL2","IL1B","APOE","CD163","CD40","CD274","STMN1","CD14","CD52")
mph_only <- ScaleData(mph_only, features = markers)
mph_only <- RunPCA(mph_only, features = markers, reduction.name = "marker_pca")

mph_only <- FindNeighbors(mph_only, reduction = "marker_pca", dims = 1:3)
mph_only <- FindClusters(mph_only, resolution = 0.5, graph.name = "RNA_snn", group.singletons = FALSE)
mph_only <- RunUMAP(mph_only, reduction = "marker_pca", dims = 1:3)

# Add subclusters back to main object
PDAC$subclusters <- subclustered_mph[Cells(PDAC)]

# Visualize macrophage subclusters
DimPlot(mph_only, group.by = "seurat_clusters", reduction = "umap") + 
  ggtitle("Supervised Subclustering by Marker PCA")

# Feature plots using SeuratExtend
FeaturePlot3(mph_only, feature.1 = "IRF5", feature.2 = "IL1B", pt.size = 3)
VlnPlot(mph_only, features = c("IRF5", "IL1B"))

# ==============================
# 5. Z-scores for variable features
# ==============================
genes.zscore <- CalcStats(
  mph_only,
  features = VariableFeatures(mph_only),
  group.by = "seurat_clusters",
  order = "p",
  n = 4
)
Heatmap(genes.zscore, lab_fill = "zscore")

# ==============================
# 6. GO / KEGG enrichment analysis
# ==============================
library(circlize)
library(ReactomePA)
library(enrichplot)

sig_degs <- degs %>% filter(p_val_adj < 0.01)

gene_list <- sig_degs %>%
  group_by(cluster) %>%
  summarise(genes = list(gene)) %>%
  deframe()

gene_list_entrez <- lapply(gene_list, function(g) {
  bitr(g, fromType = "SYMBOL", toType = "ENTREZID", OrgDb = org.Hs.eg.db) %>% pull(ENTREZID)
})

go_comp_BP <- compareCluster(geneCluster = gene_list_entrez, fun = "enrichGO", OrgDb = org.Hs.eg.db, ont = "BP", pvalueCutoff = 0.05, qvalueCutoff = 0.1, readable = TRUE)
go_comp_MF <- compareCluster(geneCluster = gene_list_entrez, fun = "enrichGO", OrgDb = org.Hs.eg.db, ont = "MF", pvalueCutoff = 0.1, qvalueCutoff = 0.1, readable = TRUE)
go_comp_CC <- compareCluster(geneCluster = gene_list_entrez, fun = "enrichGO", OrgDb = org.Hs.eg.db, ont = "CC", pvalueCutoff = 0.1, qvalueCutoff = 0.1, readable = TRUE)
kegg_comp <- compareCluster(geneCluster = gene_list_entrez, fun = "enrichKEGG", organism = "hsa", pvalueCutoff = 0.05, qvalueCutoff = 0.1)

# Combine GO / KEGG results
go_df_bp <- as.data.frame(go_comp_BP) %>% mutate(source = "GO_BP")
go_df_mf <- as.data.frame(go_comp_MF) %>% mutate(source = "GO_MF")
go_df_cc <- as.data.frame(go_comp_CC) %>% mutate(source = "GO_CC")
kegg_df <- as.data.frame(kegg_comp) %>% mutate(source = "KEGG")

# ==============================
# 7. Chord diagram for selected GO terms
# ==============================
go_df_chord <- go_df_bp %>%
  mutate(GeneHits = as.numeric(sub("/.*", "", GeneRatio)), Cluster = paste0("Cluster_", Cluster)) %>%
  dplyr::select(from = Cluster, to = Description, value = GeneHits)

wanted_terms <- c(
  "response to lipopolysaccharide",
  "lipoprotein metabolic process",
  "chemotaxis",
  "mononuclear cell migration",
  "phagocytosis"
)

go_df_chord_manual <- go_df_chord %>% filter(to %in% wanted_terms)

my_colors <- c(
  "Cluster_0" = "#AEC6CF", "Cluster_1" = "#CC7E87", "Cluster_2" = "#77DD77",
  "Cluster_3" = "#CBAACB", "Cluster_4" = "#F4B183",
  "response to lipopolysaccharide" = "#B5EAEA",
  "lipoprotein metabolic process" = "#EFD9A1",
  "chemotaxis" = "#F2A2B0",
  "phagocytosis" = "#F1C0E8",
  "mononuclear cell migration" = "#AEC6CF",
  "regulation of leukocyte chemotaxis"
)

chordDiagram(
  go_df_chord_manual,
  transparency = 0.4,
  annotationTrack = c("name", "grid"),
  grid.col = my_colors
)

write.csv(sig_degs, "top10deg_mph_sub.csv", row.names = FALSE)
write.csv(go_df_bp, "GO_comp_BP.csv", row.names = FALSE)
